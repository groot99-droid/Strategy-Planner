          "wcag22Minimum": 3.0,
          "nonText": true,
          "advisory": true,
          "passes": false
        },
        {
          "pair": "ring-on-background",
          "label": "Focus ring against background",
          "foreground": "#FFFFFF",
          "background": "#000000",
          "ratio": 21.0,
          "wcag22Minimum": 3.0,
          "nonText": true,
