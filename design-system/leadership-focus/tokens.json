      "$description": "Card"
    },
    "card-foreground": {
      "$type": "color",
      "$value": "#F8FAFC",
      "$description": "Card Foreground"
    },
    "muted": {
      "$type": "color",
      "$value": "#181818",
      "$description": "Muted"
