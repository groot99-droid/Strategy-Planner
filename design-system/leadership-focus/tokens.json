          "foreground": "#FFFFFF",
          "background": "#1E1B4B",
          "ratio": 15.99,
          "wcag22Minimum": 4.5,
          "nonText": false,
          "advisory": false,
          "passes": true
        },
        {
          "pair": "on-accent-on-accent",
          "label": "Text on accent/CTA",
          "foreground": "#FFFFFF",
          "background": "#E11D48",
          "ratio": 4.7,
          "wcag22Minimum": 4.5,
          "nonText": false,
          "advisory": false,
          "passes": true
        },
        {
          "pair": "on-destructive-on-destructive",
          "label": "Text on destructive",
          "foreground": "#000000",
          "background": "#EF4444",
          "ratio": 5.58,
          "wcag22Minimum": 4.5,
