    "border": {
      "$type": "color",
      "$value": "#312E81",
      "$description": "Border"
    },
    "destructive": {
      "$type": "color",
      "$value": "#EF4444",
      "$description": "Destructive"
    },
    "on-destructive": {
      "$type": "color",
      "$value": "#000000",
      "$description": "On Destructive"
    },
    "ring": {
      "$type": "color",
      "$value": "#FFFFFF",
      "$description": "Ring"
    }
  },
  "font": {
    "family": {
      "heading": {
        "$type": "fontFamily",
        "$value": [
          "Inter",
          "sans-serif"
        ],
        "$description": "Heading typeface"
      },
      "body": {
        "$type": "fontFamily",
        "$value": [
          "Inter",
          "sans-serif"
        ],
        "$description": "Body typeface"
      }
    }
  },
  "space": {
    "xs": {
      "$type": "dimension",
      "$value": "4px",
      "$description": "Tight gaps",
      "$extensions": {
        "cc.uupm": {
          "rem": "0.25rem"
        }
      }
    },
    "sm": {
      "$type": "dimension",
      "$value": "8px",
      "$description": "Icon gaps, inline spacing",
      "$extensions": {
        "cc.uupm": {
          "rem": "0.5rem"
        }
      }
    },
    "md": {
      "$type": "dimension",
      "$value": "16px",
      "$description": "Standard padding",
      "$extensions": {
        "cc.uupm": {
          "rem": "1rem"
        }
      }
    },
    "lg": {
      "$type": "dimension",
      "$value": "24px",
      "$description": "Section padding",
      "$extensions": {
        "cc.uupm": {
          "rem": "1.5rem"
        }
      }
    },
    "xl": {
      "$type": "dimension",
      "$value": "32px",
      "$description": "Large gaps",
      "$extensions": {
        "cc.uupm": {
          "rem": "2rem"
        }
      }
    },
    "2xl": {
      "$type": "dimension",
      "$value": "48px",
      "$description": "Section margins",
      "$extensions": {
        "cc.uupm": {
          "rem": "3rem"
        }
      }
    },
    "3xl": {
      "$type": "dimension",
      "$value": "64px",
      "$description": "Hero padding",
      "$extensions": {
        "cc.uupm": {
          "rem": "4rem"
        }
      }
    }
  },
  "radius": {
    "sm": {
      "$type": "dimension",
      "$value": "4px",
      "$description": "Inputs, small chips"
    },
    "md": {
      "$type": "dimension",
      "$value": "8px",
      "$description": "Buttons, cards"
    },
    "lg": {
      "$type": "dimension",
      "$value": "12px",
      "$description": "Panels, modals"
    },
    "xl": {
      "$type": "dimension",
      "$value": "16px",
      "$description": "Hero surfaces"
    },
    "full": {
      "$type": "dimension",
      "$value": "9999px",
      "$description": "Pills, avatars"
    }
  },
  "shadow": {
    "sm": {
      "$type": "shadow",
      "$value": "0 1px 2px rgba(0,0,0,0.05)",
      "$description": "Subtle lift",
      "$extensions": {
        "cc.uupm": {
          "encoding": "css-shorthand"
        }
      }
    },
    "md": {
      "$type": "shadow",
      "$value": "0 4px 6px rgba(0,0,0,0.1)",
      "$description": "Cards, buttons",
      "$extensions": {
        "cc.uupm": {
          "encoding": "css-shorthand"
        }
      }
    },
    "lg": {
      "$type": "shadow",
      "$value": "0 10px 15px rgba(0,0,0,0.1)",
      "$description": "Modals, dropdowns",
      "$extensions": {
        "cc.uupm": {
          "encoding": "css-shorthand"
        }
      }
    },
    "xl": {
      "$type": "shadow",
      "$value": "0 20px 25px rgba(0,0,0,0.15)",
      "$description": "Hero images, featured cards",
      "$extensions": {
        "cc.uupm": {
          "encoding": "css-shorthand"
        }
      }
    }
  },
  "motion": {
    "reducedMotion": {
      "default": {
        "$type": "string",
        "$value": "@media (prefers-reduced-motion: reduce) - do not auto-advance at all; require an explicit user action (WCAG 2.2.2)",
        "$description": "prefers-reduced-motion fallback for this preset"
      }
    },
    "easing": {
      "default": {
        "$type": "cubicBezier",
        "$value": [
          0.0,
          0.0,
          1.0,
          1.0
        ],
        "$description": "Approximation of GSAP `none`",
        "$extensions": {
          "cc.uupm": {
            "gsapEase": "none"
          }
        }
      }
    }
  },
  "$extensions": {
    "cc.uupm": {
      "valueEncoding": "string-legacy",
      "category": "Video Streaming/OTT",
      "style": "Dark Mode (OLED)",
      "styleId": "dark-mode-oled",
      "pattern": "Hero-Centric Design",
      "dials": {
        "variance": 7,
        "variance_label": "Balanced / Modern",
        "motion": 6,
        "motion_label": "Standard",
        "density": 4,
        "density_label": "Standard"
      },
      "sourceIdentities": {
        "product": "Video Streaming/OTT",
        "reasoning": "Video Streaming/OTT",
        "style": "dark-mode-oled",
        "color": "Video Streaming/OTT",
        "typography": "Modern Dark Cinema (Inter System)",
        "landing": "Hero-Centric Design"
      },
      "contrast": [
        {
          "pair": "foreground-on-background",
          "label": "Body text",
          "foreground": "#F8FAFC",
          "background": "#000000",
          "ratio": 20.07,
          "wcag22Minimum": 4.5,
          "nonText": false,
          "advisory": false,
          "passes": true
        },
        {
          "pair": "on-primary-on-primary",
          "label": "Text on primary",
          "foreground": "#FFFFFF",
          "background": "#0F0F23",
          "ratio": 18.87,
          "wcag22Minimum": 4.5,
          "nonText": false,
          "advisory": false,
          "passes": true
        },
        {
          "pair": "on-secondary-on-secondary",
